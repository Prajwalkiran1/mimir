# CPU / Apple-Silicon (linux/arm64) image for local testing — NOT the GPU/EC2 Dockerfile.
# All model caches are redirected to /cache (a Docker volume) so nothing lands in the
# host home dir. ffmpeg + tesseract are installed in-image (no Homebrew needed).
FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    DEBIAN_FRONTEND=noninteractive \
    HF_HOME=/cache \
    TORCH_HOME=/cache \
    SENTENCE_TRANSFORMERS_HOME=/cache \
    NLTK_DATA=/cache/nltk \
    HF_HUB_DISABLE_TELEMETRY=1 \
    PIP_DEFAULT_TIMEOUT=120

RUN apt-get update && apt-get install -y --no-install-recommends \
        ffmpeg \
        tesseract-ocr \
        build-essential \
        curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements-docker.txt .
# BuildKit cache mount keeps downloaded wheels across build attempts, so a dropped
# connection (e.g. the large torch wheel) resumes from cache instead of re-downloading.
# Install the CPU-only torch build first from PyTorch's CPU index: this avoids pulling
# ~2 GB of nvidia_* / triton CUDA wheels that are dead weight on a CPU-only Mac. The
# subsequent `-r` install then sees torch already satisfied and won't re-resolve it.
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --upgrade pip && \
    pip install --retries 10 --timeout 120 \
        --index-url https://download.pytorch.org/whl/cpu 'torch>=2.2' && \
    pip install --retries 10 --timeout 120 -r requirements-docker.txt

# spaCy model (in-image) + nltk data (into the /cache volume)
RUN python -m spacy download en_core_web_sm && \
    python -m nltk.downloader -d /cache/nltk punkt punkt_tab stopwords

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# App code is bind-mounted at runtime (see docker-compose.mac.yml), so no COPY of source.
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
